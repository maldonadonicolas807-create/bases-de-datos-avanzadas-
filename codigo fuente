-- 3. REGISTRO DEL ESQUEMA XSD EN LA BASE DE DATOS
-- ============================================================================
BEGIN
  DBMS_XMLSCHEMA.REGISTERSCHEMA(
    schemaurl => 'http://localhost/schemas/reporte_empresa.xsd',
    schemadoc => 
'<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
   <xs:element name="ReporteEmpresa">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="Departamento" maxOccurs="unbounded">
               <xs:complexType>
                  <xs:sequence>
                     <xs:element name="NombreDepartamento" type="xs:string"/>
                     <xs:element name="Empleado" minOccurs="0" maxOccurs="unbounded">
                        <xs:complexType>
                           <xs:sequence>
                              <xs:element name="NombreCompleto" type="xs:string"/>
                              <xs:element name="Correo" type="xs:string"/>
                              <xs:element name="Cargo" type="xs:string"/>
                              <xs:element name="Salario" type="xs:decimal"/>
                           </xs:sequence>
                           <xs:attribute name="id" type="xs:integer" use="required"/>
                        </xs:complexType>
                     </xs:element>
                  </xs:sequence>
                  <xs:attribute name="id" type="xs:integer" use="required"/>
               </xs:complexType>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
</xs:schema>',
    local     => TRUE,
    gentables => FALSE,
    genviews  => FALSE
);
END;
/


-- ============================================================================
-- 4. CREACIÓN DE LA TABLA XMLTYPE ENLAZADA AL ESQUEMA XSD
-- ============================================================================
CREATE TABLE reporte_xml_tabla OF XMLType
XMLSCHEMA "http://localhost/schemas/reporte_empresa.xsd"
ELEMENT "ReporteEmpresa";


-- ============================================================================
-- 5. CONSULTA SQL/XML GENERADORA DEL REPORTE JERÁRQUICO
-- ============================================================================
SET PAGESIZE 5000
SET LONG 2000000
SET LONGCHUNKSIZE 2000000

SELECT XMLSERIALIZE(DOCUMENT 
           XMLELEMENT("ReporteEmpresa",
               XMLAGG(
                   XMLELEMENT("Departamento",
                       XMLATTRIBUTES(d.department_id AS "id"),
                       XMLELEMENT("NombreDepartamento", d.department_name),
                       (SELECT XMLAGG(
                               XMLELEMENT("Empleado",
                                   XMLATTRIBUTES(e.employee_id AS "id"),
                                   XMLATTRIBUTES(e.employee_id AS "id"),
                                   XMLELEMENT("NombreCompleto", e.first_name || ' ' || e.last_name),
                                   XMLELEMENT("Correo", e.email),
                                   XMLELEMENT("Cargo", j.job_title),
                                   XMLELEMENT("Salario", e.salary)
                               )
                           )
                        FROM employees e
                        JOIN jobs j ON e.job_id = j.job_id
                        WHERE e.department_id = d.department_id
                       )
                   )
               )
           ) AS CLOB INDENT SIZE = 2) AS xml_resultado
FROM departments d;


